{
  "name": "lili",
  "version": "0.4.2",
  "private": true,
  "description": "Extension navigateur : traduire, reformuler et résumer la sélection ou la page entière.",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:zip": "node scripts/build.mjs --zip",
    "check": "node scripts/check.mjs",
    "icons": "python3 scripts/make-icons.py",
    "lint:firefox": "web-ext lint --source-dir dist/firefox --warnings-as-errors",
    "test:e2e": "node scripts/build.mjs --zip && node test/e2e/run.mjs",
    "test": "npm run check && npm run test:e2e",
    "verify:version": "node scripts/verify-version.mjs",
    "version:set": "node scripts/bump-version.mjs",
    "release:notes": "node scripts/release-notes.mjs"
  },
  "engines": {
    "node": ">=20.11"
  },
  "devDependencies": {
    "@puppeteer/browsers": "^3.2.7",
    "puppeteer-core": "^25.18.1",
    "web-ext": "^10.8.0"
  },
  "license": "MPL-2.0"
}
