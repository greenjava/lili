{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "short_name": "Lili",
  "version": "0.4.2",
  "default_locale": "en",
  "description": "__MSG_extensionDescription__",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "storage",
    "contextMenus"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "host_permissions": [
    "https://api.openai.com/*",
    "https://api.anthropic.com/*",
    "http://localhost:11434/*",
    "http://127.0.0.1:11434/*"
  ],
  "action": {
    "default_title": "__MSG_actionTitle__",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "shared/i18n.js",
        "shared/constants.js",
        "content/styles.js",
        "content/content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "commands": {
    "translate-selection": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y"
      },
      "description": "__MSG_commandTranslate__"
    },
    "rephrase-selection": {
      "suggested_key": {
        "default": "Ctrl+Shift+U"
      },
      "description": "__MSG_commandRephrase__"
    },
    "summarize-selection": {
      "suggested_key": {
        "default": "Ctrl+Shift+H"
      },
      "description": "__MSG_commandSummarizeSelection__"
    },
    "summarize-page": {
      "suggested_key": {
        "default": "Ctrl+Shift+E"
      },
      "description": "__MSG_commandSummarizePage__"
    }
  }
}
